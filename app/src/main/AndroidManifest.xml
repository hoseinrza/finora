<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions:
      RECEIVE_SMS       - required: BankSmsReceiver reads the incoming SMS broadcast extras
                           (Telephony.Sms.Intents.getMessagesFromIntent) to detect bank transaction texts.
                           READ_SMS is intentionally NOT requested - the app never queries the SMS
                           inbox/content provider, only the broadcast payload, so declaring READ_SMS
                           would be an unused, over-broad permission under Play Console's SMS/Call Log policy.
      POST_NOTIFICATIONS - required on API 33+ to show the transaction-detected system notification.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bank SMS Broadcast Receiver -->
        <receiver
            android:name=".services.BankSmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Bank Notification Listener Service -->
        <service
            android:name=".services.BankNotificationService"
            android:label="خوانش خودکار نوتیفیکیشن بانکی"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
